{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/",
        "http://localhost:3200/proyectos/mesa-viva",
        "http://localhost:3200/proyectos/caudal",
        "http://localhost:3200/proyectos/ventas-inventario",
        "http://localhost:3200/proyectos/cocina"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
